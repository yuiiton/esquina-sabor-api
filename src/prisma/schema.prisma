datasource db {
  provider = "sqlite"
  url      = "file:../data/database.sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  cpf   String @unique
  role  String @default("user")
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  price       Float
  imageUrl    String
  available   Boolean @default(true)
}